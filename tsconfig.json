{
  "compilerOptions": {
    "strict": false,
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true
  },
  "exclude": [
    ".vite",
    "coverage",
    "node_modules",
    "src/**/*.test.js",
    "**/__mocks__/**",
    "src/contracts",
    "vitest.config.js"
  ],
  "include": ["**/*.cjs", "**/*.js", "**/*.d.ts", ".*.js"]
}
