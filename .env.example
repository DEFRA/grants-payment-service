AWS_ENDPOINT=http://localhost:4566
AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EMF_ENVIRONMENT=Local

HTTP_PROXY=http://localhost:8080
NODE_USE_ENV_PROXY=1

SNS_ENDPOINT=http://localhost:4566
SNS_TOPIC_ARN_AUDIT=arn:aws:sns:eu-west-2:000000000000:fcp_audit_grants_payment_service

ENABLE_TEST_ENDPOINTS=true
ENABLE_REQUEST_LOGGER_DEBUG=true

# Subscribe to payment hub BATCH_REJECTED events via the in-process Service Bus
# HTTP stub in azure-service-bus-stub (start the stub via its compose.yml)
# ENABLE_BATCH_REJECTED_SUBSCRIPTION=true
# SERVICE_BUS_BASE_URL=http://localhost:3001

MONGO_URI=mongodb://localhost:27018/
